{
  "manifest_version": 3,
  "name": "Amplifier Library",
  "version": "1.1.0",
  "description": "Add images to the Amplifier studio library: right-click any image, or import a whole Pinterest board.",
  "permissions": ["contextMenus", "storage", "notifications", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "Amplifier Library", "default_popup": "popup.html" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
